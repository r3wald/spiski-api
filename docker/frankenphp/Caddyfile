{
	frankenphp
	admin off
	auto_https off
}

:80 {
	root * /app/public

	# SSE-Streams nicht komprimieren: kostet Speicher je Abonnent und
	# ermoeglicht BREACH-artige Angriffe.
	@compressible not path /.well-known/mercure
	encode @compressible zstd gzip

	# HSTS ist Pflicht, sobald echtes TLS davor haengt (CLAUDE.md 6). Lokal ueber
	# HTTP schadet der Header nicht, weil Browser ihn nur ueber HTTPS auswerten.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}

	# Live-Updates (CLAUDE.md 13): Mercure-Hub, eingebaut in FrankenPHP. Die API
	# veroeffentlicht intern ueber http://localhost, die Apps abonnieren mit dem
	# Token aus GET /v1/live. Aussteller und Zielgruppe muessen zu
	# config/packages/mercure.yaml passen. Ohne Persistenz: Wer etwas verpasst,
	# synchronisiert beim Verbinden ohnehin.
	mercure {
		issuer https://spiski.r3wald.net {
			publisher {
				jwt {env.MERCURE_JWT_SECRET} HS256
			}
			subscriber {
				jwt {env.MERCURE_JWT_SECRET} HS256
			}
		}
		resource_identifier https://spiski.r3wald.net/.well-known/mercure
	}

	# Startseite: statisch, ohne PHP. Sonst reicht php_server "/" an index.php
	# weiter, und Besucher sehen die Symfony-404-Seite statt einer Willkommensseite.
	handle / {
		rewrite * /index.html
		header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; img-src data:; frame-ancestors 'none'"
		file_server
	}

	# Datenschutzerklaerung: statisch, ohne PHP, wie die Startseite.
	redir /datenschutz /datenschutz/
	handle /datenschutz/ {
		rewrite * /datenschutz/index.html
		header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; img-src data:; frame-ancestors 'none'"
		file_server
	}

	# Teilen-Link (CLAUDE.md 12): Mit installierter App oeffnet Android ihn direkt
	# (App Link, verifiziert ueber assetlinks.json); sonst eine statische Anleitung.
	# Der Code steht in der URL: kein Referer, kein Cache.
	handle /join/* {
		rewrite * /join.html
		header {
			Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'unsafe-inline'; img-src data:; frame-ancestors 'none'"
			Referrer-Policy "no-referrer"
			Cache-Control "no-store"
		}
		file_server
	}

	# Web-App (Flutter, `make build-web` im App-Projekt). Pfade ohne Datei
	# (/app/list/…, /app/join/…) liefern index.html, den Rest routet die App.
	# 'wasm-unsafe-eval' braucht CanvasKit; Flutter laedt fehlende Schriften
	# von fonts.gstatic.com nach. no-cache: neue Versionen sofort, per ETag.
	redir /app /app/
	handle /app/* {
		try_files {path} /app/index.html
		header {
			Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://fonts.gstatic.com; worker-src 'self' blob:; manifest-src 'self'; frame-ancestors 'none'"
			Cache-Control "no-cache"
		}
		file_server
	}

	# Admin-Oberflaeche (Vue, Quellen in admin/, `make admin-build` baut nach
	# public/admin). Statisch, ohne PHP; die Daten holt sie mit dem Admin-Token
	# von /v1/admin. Pfade ohne Datei (/admin/lists/…) liefern index.html, den
	# Rest routet die App. Strenge CSP: nur eigene Skripte und Styles, kein Inline,
	# keine fremden Ressourcen – schuetzt das Token im sessionStorage vor XSS.
	redir /admin /admin/
	handle /admin/* {
		try_files {path} /admin/index.html
		header {
			Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
			Referrer-Policy "no-referrer"
			X-Robots-Tag "noindex, nofollow"
			Cache-Control "no-cache"
		}
		file_server
	}

	handle /.well-known/assetlinks.json {
		header Content-Type "application/json"
		file_server
	}

	# Alles andere: statische Dateien direkt, sonst Symfony (public/index.php).
	handle {
		php_server
	}

	# Der Browser schickt das Mercure-Abo-Token als Query-Parameter mit.
	log {
		output stdout
		format filter {
			wrap console
			request>uri query {
				replace authorization REDACTED
			}
		}
	}
}
