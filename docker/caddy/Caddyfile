{
	admin off
	auto_https off
}

:80 {
	root * /app/public

	encode gzip

	# HSTS ist Pflicht, sobald echtes TLS davor haengt (CLAUDE.md 6). Lokal ueber
	# HTTP schadet der Header nicht, weil Browser ihn nur ueber HTTPS auswerten.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}

	# Startseite: statisch, ohne PHP. Sonst reicht php_fastcgi "/" an index.php
	# weiter, und Besucher sehen die Symfony-404-Seite statt einer Willkommensseite.
	handle / {
		rewrite * /index.html
		header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; img-src data:; frame-ancestors 'none'"
		file_server
	}

	handle {
		php_fastcgi php:9000 {
			root /app/public
		}

		file_server
	}

	log {
		output stdout
		format console
	}
}
