# vendor/ kommt aus dem composer-install-Layer, nicht vom Host – sonst landet
# der dev-Stand inklusive Dev-Abhaengigkeiten im prod-Image.
vendor/
var/

# Enthalten personenbezogene Daten und haben in keinem Image etwas zu suchen.
backups/

.git/
.github/
.idea/
.phpunit.cache/
tests/
phpunit.dist.xml
phpstan.dist.neon
Makefile
compose.yaml

.env.local
.env.*.local

# Server-Secrets kommen zur Laufzeit per env_file, nie ins Image.
.env.prod
.env.staging

# Deploy-Skripte laufen lokal, nicht im Container.
update-*.sh

# Compose-Dateien und Webserver-Konfiguration gehoeren nicht ins Image
# (das Caddyfile wird eingehaengt).
compose.prod.yaml
docker/frankenphp/

# Gross und per Bind-Mount von public/ ohnehin da.
public/*.apk
public/spiski.json
public/app/

# Admin-Oberflaeche: Quellen und node_modules braucht das Image nicht, der Build
# kommt wie public/app per Bind-Mount von public/.
admin/
public/admin/
